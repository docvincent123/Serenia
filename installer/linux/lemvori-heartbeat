#!/usr/bin/env python3
"""Opt-in, metadata-only heartbeat from a center to LemvoriLab operator hub.

This agent never transmits clinical notes, patients, staff names, statistics,
database files, or access credentials beyond its own revocable heartbeat token.
Actual encrypted backups remain the separate restic/SFTP workflow.
"""
import json
import os
from pathlib import Path
import re
import stat
import sys
from datetime import datetime,timezone
from urllib.parse import urlsplit
from urllib.request import Request,build_opener,HTTPRedirectHandler,urlopen

CONFIG=Path('/etc/solvia/operator-hub.json')
STATE=Path('/var/lib/solvia-continuity')
OFFSITE=Path('/etc/solvia/offsite.json')

class RejectRedirect(HTTPRedirectHandler):
    def redirect_request(self,req,fp,code,msg,headers,newurl):
        raise RuntimeError('Hub redirect refused (would expose bearer token)')

def private_file(path):
    if path.is_symlink() or not path.is_file():
        raise RuntimeError('Missing secure configuration')
    if stat.S_IMODE(path.stat().st_mode)&0o077:
        raise RuntimeError('Secret file permissions must be 0600')
    return path.read_text(encoding='utf-8').strip()

def backup_state():
    if not OFFSITE.is_file():return 'not_configured',''
    latest=0
    failures=0
    if STATE.is_dir():
        for path in STATE.glob('*.json'):
            try:
                item=json.loads(path.read_text())
                if item.get('state')=='success':
                    latest=max(latest,int(item.get('completed_at') or 0))
                elif item.get('state')=='pending' and item.get('attempts',0)>0:
                    failures+=1
            except (ValueError,OSError,TypeError):
                pass
    when=datetime.fromtimestamp(latest,timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ') if latest else ''
    age=datetime.now(timezone.utc).timestamp()-latest if latest else float('inf')
    if failures>0 or (latest and age>48*3600):return 'failed',when
    return ('ok' if latest else 'unknown'),when

def run():
    if not CONFIG.is_file():
        return 0  # Not enrolled: opt-in only.
    options=json.loads(private_file(CONFIG))
    hub=options.get('hub_url','').rstrip('/')
    parsed=urlsplit(hub)
    if parsed.scheme!='https' or not parsed.hostname or parsed.username or parsed.password or parsed.path not in ('','/') or parsed.query or parsed.fragment:
        raise RuntimeError('Hub URL must be an HTTPS origin')
    expected=options.get('server_id')
    if not isinstance(expected,str) or not re.fullmatch('[0-9a-f]{64}',expected):
        raise RuntimeError('Invalid server identity')
    token=private_file(Path(options.get('token_file','')))
    if len(token)<32 or len(token)>128:raise RuntimeError('Invalid heartbeat token')
    with urlopen('http://127.0.0.1:8765/api/health',timeout=8) as response:
        health=json.load(response)
    if health.get('server_id')!=expected:
        raise RuntimeError('Installed server does not match enrolled center')
    status,latest=backup_state()
    payload=json.dumps({'server_id':expected,'version':health.get('version',''),
                        'backup_status':status,'last_backup_at':latest},separators=(',',':')).encode()
    request=Request(hub+'/api/heartbeat',payload,method='POST',
                    headers={'Content-Type':'application/json','Authorization':'Bearer '+token})
    with build_opener(RejectRedirect).open(request,timeout=12) as response:
        if response.status!=200:raise RuntimeError('Operator hub did not accept heartbeat')
    return 0

if __name__=='__main__':
    try:sys.exit(run())
    except Exception as error:
        # Never print the hub URL, bearer token, or file content to journalctl.
        print('Operator heartbeat failed: '+type(error).__name__,file=sys.stderr)
        sys.exit(1)
