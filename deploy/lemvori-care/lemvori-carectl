#!/usr/bin/env bash
set -Eeuo pipefail
cmd=${1:-status}
case "$cmd" in
  start|stop|restart) systemctl "$cmd" lemvori-care.service ;;
  status) systemctl status lemvori-care.service lemvori-care-network.timer --no-pager ;;
  logs) journalctl -u lemvori-care.service -u lemvori-care-network-refresh.service -n 80 --no-pager ;;
  address)
    ip=$(cat /etc/lemvori-care/address)
    printf 'Local: https://localhost:8443\nLAN:   https://%s:8443\n' "$ip" ;;
  health) curl --fail --silent --show-error --max-time 10 \
    --cacert /etc/lemvori-care/ca/ca.crt https://127.0.0.1:8443/api/health; echo ;;
  certificate) openssl x509 -in /etc/lemvori-care/ca/ca.crt -noout -fingerprint -sha256 ;;
  network) /opt/lemvori-care/network-tls.sh ;;
  backup)
    [[ $EUID -eq 0 ]] || { echo 'Run with sudo' >&2; exit 1; }
    install -d -o root -g root -m 0700 /run/lemvori-care /var/backups/lemvori-care
    exec 8>/run/lemvori-care/db-maintenance.lock
    flock -n 8 || { echo "Database maintenance in progress" >&2; exit 1; }
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    target="/var/backups/lemvori-care/lemvori-core-$stamp.dump"
    [[ ! -e $target ]] || { echo 'Backup already exists' >&2; exit 1; }
    partial=$(mktemp /var/backups/lemvori-care/.backup.XXXXXXXX)
    trap 'rm -f "$partial"' EXIT
    runuser -u lemvori-care -- env PGPASSFILE=/etc/lemvori-care/pgpass \
       /usr/bin/pg_dump --format=custom --no-owner --no-privileges \
       -h 127.0.0.1 -p 5432 -U lemvori_app -d lemvori_core > "$partial"
    /usr/bin/pg_restore --list "$partial" >/dev/null
    chmod 0600 "$partial"
    mv -n -- "$partial" "$target"
    trap - EXIT
    echo "Lemvori Care database backup: $target"
    ;;
  restore)
    [[ $EUID -eq 0 ]] || { echo "Use sudo" >&2; exit 1; }
    [[ $# -eq 3 ]] || { echo "Usage: lemvori-carectl restore PATH ВІДНОВИТИ" >&2; exit 2; }
    exec /opt/lemvori-care/restore.sh "$2" "$3"
    ;;
  restore-latest)
    [[ $EUID -eq 0 && $# -eq 2 && $2 == "ВІДНОВИТИ" ]] || { echo "Use sudo and confirm ВІДНОВИТИ" >&2; exit 2; }
    shopt -s nullglob
    archives=(/var/backups/lemvori-care/lemvori-core-[0-9]*.dump)
    (( ${#archives[@]} > 0 )) || { echo "No backups" >&2; exit 1; }
    latest=$(ls -1t -- "${archives[@]}" | head -n 1)
    exec /opt/lemvori-care/restore.sh "$latest" "$2"
    ;;
  list-backups)
    [[ $EUID -eq 0 ]] || { echo "Use sudo" >&2; exit 1; }
    shopt -s nullglob
    archives=(/var/backups/lemvori-care/lemvori-core-[0-9]*.dump)
    if (( ${#archives[@]} )); then ls -1th -- "${archives[@]}"; else echo "No backups"; fi
    ;;
  diagnose) exec /opt/lemvori-care/verify-host.sh ;;
  publisher-key)
    [[ $EUID -eq 0 ]] || { echo 'Run with sudo' >&2; exit 1; }
    source_file=${2:-}
    [[ -f $source_file && -r $source_file && ! -L $source_file ]] || {
      echo 'Supply the signed publisher ED25519 PUBLIC .pem file (not a private key)' >&2; exit 1;
    }
    if [[ -e /etc/lemvori-care/license/publisher.pem ]]; then
      echo 'Publisher key already provisioned. Refusing silent replacement.' >&2; exit 1
    fi
    openssl pkey -pubin -in "$source_file" -text -noout | grep -qi 'ED25519' || {
      echo 'Expected an Ed25519 public key. No changes made.' >&2; exit 1;
    }
    install -d -o root -g lemvori-care -m 0750 /etc/lemvori-care/license
    install -o root -g lemvori-care -m 0644 "$source_file" /etc/lemvori-care/license/publisher.pem
    echo 'Lemvori publisher verification key installed. You can import the signed center license.'
    ;;
  *) echo 'Usage: sudo lemvori-carectl {start|stop|restart|status|logs|address|health|certificate|network|backup|restore FILE ВІДНОВИТИ|restore-latest ВІДНОВИТИ|list-backups|diagnose|publisher-key FILE}' >&2; exit 2 ;;
esac
